<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TaskbarMarker</RootNamespace>
    <AssemblyName>TaskbarMarker</AssemblyName>
    <Product>Taskbar Marker</Product>
    <Description>Color-code and label individual Windows taskbar buttons.</Description>
    <Version>0.1.1</Version>
    <Authors>Leon C</Authors>
    <RepositoryUrl>https://github.com/Leoncl2025/Taskbar-Marker</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- WinForms: NotifyIcon + message loop. WPF: only for the System.Windows.Automation (UIA) client. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Update="rules.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
